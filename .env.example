# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co/rest/v1/
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dashboard PIN
DASHBOARD_PIN=079876
# PIN anggota (opsional; default Nazwa=112233, Syifa=445566)
DASHBOARD_PIN_NAZWA=
DASHBOARD_PIN_SYIFA=
# PIN akses lihat saja (default 778899)
DASHBOARD_PIN_VIEWER=
DASHBOARD_VIEWER_NAME=
# Secret tanda tangan sesi dashboard (wajib di production)
DASHBOARD_SESSION_SECRET=

# Fonnte WhatsApp gateway
FONNTE_TOKEN=
# ID grup WhatsApp tujuan reminder PO pengurus (pisahkan dengan koma jika lebih dari satu)
FONNTE_GROUP_PO=
# ID grup WhatsApp tujuan pengingat pembayaran tenant (pisahkan dengan koma jika lebih dari satu)
FONNTE_GROUP_TENANT=
# URL publik aplikasi untuk link di pesan WhatsApp
NEXT_PUBLIC_APP_URL=
# Secret untuk endpoint cron reminder (wajib di production)
CRON_SECRET=
# Secret HMAC link lacak publik (disarankan; fallback service role di production)
PUBLIC_LINK_SECRET=

# Optional: Supabase project for CLI
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Cloudflare Turnstile (wajib di production; site key di-inline saat build, redeploy setelah diubah)
# Dev test keys Cloudflare: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# Production: site key dan secret key harus dari widget yang sama.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: monitoring deployment Vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional: batas storage monitoring (default 1 GB)
SUPABASE_STORAGE_LIMIT_BYTES=1073741824
